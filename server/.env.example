PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/artcrew?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-...

# Google Places (optional - falls back to OpenStreetMap if not provided)
GOOGLE_PLACES_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Mux Video
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
